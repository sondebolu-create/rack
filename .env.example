EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to true once Google is enabled in Supabase Auth providers. Shows the "Continue with Google" button.
EXPO_PUBLIC_GOOGLE_AUTH=false

# Launch feature flags (all off for the Nov 20 web launch). See lib/flags.ts.
EXPO_PUBLIC_RACKGPT_ENABLED=false
EXPO_PUBLIC_TRYON_ENABLED=false
EXPO_PUBLIC_PAYMENTS_ENABLED=false

# Where "Report this listing" emails go. The link is hidden if this is empty.
EXPO_PUBLIC_REPORT_EMAIL=
# Public web address with no trailing slash, for share previews (Open Graph). Example: https://rack.ng
EXPO_PUBLIC_SITE_URL=

# Analytics: PostHog. Leave the key empty to send nothing. The key is the project API key (public by design).
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to the EU cloud. Use https://us.i.posthog.com if your project is in the US region.
EXPO_PUBLIC_POSTHOG_HOST=
